{
  "name": "ol-graticule-monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZwaarContrast/ol-graticule.git"
  },
  "homepage": "https://github.com/ZwaarContrast/ol-graticule#readme",
  "bugs": {
    "url": "https://github.com/ZwaarContrast/ol-graticule/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "demos"
  ],
  "scripts": {
    "build": "node node_modules/typescript-7/bin/tsc --build",
    "type-check": "node node_modules/typescript-7/bin/tsc --build --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "knip": "npx knip",
    "changeset": "changeset",
    "version": "changeset version && node scripts/aggregate-changelog.mjs",
    "release": "npm run build && changeset publish",
    "demo:dev": "npm run dev --workspace=ol-graticule-demos",
    "demo:build": "npm run build && npm run build --workspace=ol-graticule-demos",
    "clean": "node node_modules/typescript-7/bin/tsc --build --clean && rm -rf packages/*/node_modules demos/node_modules demos/dist node_modules",
    "bench": "npm run bench --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=ol-graticule-demos"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.17.0",
    "@types/proj4": "^2.5.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.9.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.0.17"
  }
}

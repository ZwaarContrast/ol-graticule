{
  "name": "@zwaarcontrast/ol-graticule-rd",
  "version": "3.0.0",
  "type": "module",
  "description": "Dutch RD grids, RD New (EPSG:28992) and RD Old (EPSG:28991), with the bundled RDNAPTRANS2018 datum-shift grid, for ol-graticule.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZwaarContrast/ol-graticule.git",
    "directory": "packages/ol-graticule-rd"
  },
  "homepage": "https://github.com/ZwaarContrast/ol-graticule/tree/main/packages/ol-graticule-rd#readme",
  "bugs": {
    "url": "https://github.com/ZwaarContrast/ol-graticule/issues"
  },
  "keywords": [
    "openlayers",
    "ol",
    "graticule",
    "grid",
    "rd",
    "rd-new",
    "rd-amersfoort",
    "epsg-28992",
    "rdnaptrans",
    "netherlands",
    "rijksdriehoek"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-7/bin/tsc --build",
    "type-check": "tsc --build --noEmit",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "encode-rdtrans": "node scripts/encode-rdtrans.mjs",
    "bench": "vitest bench"
  },
  "peerDependencies": {
    "@zwaarcontrast/ol-graticule": "^3.0.0",
    "@zwaarcontrast/ol-graticule-projected": "^3.0.0",
    "ol": "^10.0.0",
    "proj4": "^2.21.0"
  },
  "devDependencies": {
    "@zwaarcontrast/ol-graticule": "*",
    "@zwaarcontrast/ol-graticule-projected": "*",
    "@zwaarcontrast/test-utils": "*",
    "typescript": "~6.0.3",
    "vitest": "^4.0.17"
  }
}

{
  "name": "@zwaarcontrast/ol-graticule-os",
  "version": "0.2.0",
  "type": "module",
  "description": "Historical Ordnance Survey grids for ol-graticule: the 1930s transverse Mercator yard grid of Great Britain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZwaarContrast/ol-graticule.git",
    "directory": "packages/ol-graticule-os"
  },
  "homepage": "https://github.com/ZwaarContrast/ol-graticule/tree/main/packages/ol-graticule-os#readme",
  "bugs": {
    "url": "https://github.com/ZwaarContrast/ol-graticule/issues"
  },
  "keywords": [
    "openlayers",
    "ol",
    "graticule",
    "grid",
    "ordnance-survey",
    "great-britain",
    "yard-grid",
    "transverse-mercator",
    "osgb36",
    "1930s"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./headless": {
      "import": "./dist/headless.js",
      "types": "./dist/headless.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-7/bin/tsc --build",
    "type-check": "tsc --build --noEmit",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@zwaarcontrast/ol-graticule": "^4.0.0",
    "@zwaarcontrast/ol-graticule-projected": "^4.0.0",
    "ol": "^10.0.0",
    "proj4": "^2.9.0"
  },
  "devDependencies": {
    "@zwaarcontrast/ol-graticule": "*",
    "@zwaarcontrast/ol-graticule-projected": "*",
    "@zwaarcontrast/test-utils": "*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}

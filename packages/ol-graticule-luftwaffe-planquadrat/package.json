{
  "name": "@zwaarcontrast/ol-graticule-luftwaffe-planquadrat",
  "version": "2.3.0",
  "type": "module",
  "description": "WWII Luftwaffe Planquadrat map reference grids: Gradnetzmeldeverfahren (GNMV) and Jägermeldenetz (JMN), for ol-graticule.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZwaarContrast/ol-graticule.git",
    "directory": "packages/ol-graticule-luftwaffe-planquadrat"
  },
  "homepage": "https://github.com/ZwaarContrast/ol-graticule/tree/main/packages/ol-graticule-luftwaffe-planquadrat#readme",
  "bugs": {
    "url": "https://github.com/ZwaarContrast/ol-graticule/issues"
  },
  "keywords": [
    "openlayers",
    "ol",
    "graticule",
    "grid",
    "luftwaffe",
    "planquadrat",
    "gradnetzmeldeverfahren",
    "gradnetz",
    "jagermeldenetz",
    "jmn",
    "wwii",
    "military-grid"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --build --noEmit",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "ol": "^10.0.0",
    "@zwaarcontrast/ol-graticule": "^2.0.0"
  },
  "devDependencies": {
    "@zwaarcontrast/ol-graticule": "*",
    "typescript": "^5.7.2",
    "vitest": "^4.0.17"
  }

{
  "name": "@zwaarcontrast/ol-graticule-heeresgitter",
  "version": "3.0.0",
  "type": "module",
  "description": "WWII Wehrmacht map reference grids for ol-graticule: Deutsches Heeresgitter (DHG, Bessel + 6\u00b0 Gau\u00df-Kr\u00fcger), Deutsches Reichsgitter (DRG, the 3\u00b0-strip predecessor) and both Heeresmeldenetz letter-cell variants: planar (6 km, DHG-metric) and geographic (6' \u00d7 4' lat/lon).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZwaarContrast/ol-graticule.git",
    "directory": "packages/ol-graticule-heeresgitter"
  },
  "homepage": "https://github.com/ZwaarContrast/ol-graticule/tree/main/packages/ol-graticule-heeresgitter#readme",
  "bugs": {
    "url": "https://github.com/ZwaarContrast/ol-graticule/issues"
  },
  "keywords": [
    "openlayers",
    "ol",
    "graticule",
    "grid",
    "heeresgitter",
    "reichsgitter",
    "heeresmeldenetz",
    "gauss-kruger",
    "bessel",
    "wehrmacht",
    "wwii",
    "military-grid"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-7/bin/tsc --build",
    "type-check": "tsc --build --noEmit",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench"
  },
  "peerDependencies": {
    "@zwaarcontrast/ol-graticule": "^3.0.0",
    "@zwaarcontrast/ol-graticule-projected": "^3.0.0",
    "ol": "^10.0.0",
    "proj4": "^2.12.0"
  },
  "devDependencies": {
    "@types/proj4": "^2.5.5",
    "@zwaarcontrast/ol-graticule": "*",
    "@zwaarcontrast/ol-graticule-projected": "*",
    "@zwaarcontrast/test-utils": "*",
    "typescript": "~6.0.3",
    "vitest": "^4.0.17"
  }
}

{
  "name": "@zwaarcontrast/ol-graticule-heeresgitter",
  "version": "2.2.0",
  "type": "module",
  "description": "WWII Wehrmacht map reference grids for ol-graticule: Deutsches Heeresgitter (DHG, Bessel + 6° Gauß-Krüger) and both Heeresmeldenetz letter-cell variants: planar (6 km, DHG-metric) and geographic (6' × 4' lat/lon).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZwaarContrast/ol-graticule.git",
    "directory": "packages/ol-graticule-heeresgitter"
  },
  "homepage": "https://github.com/ZwaarContrast/ol-graticule/tree/main/packages/ol-graticule-heeresgitter#readme",
  "bugs": {
    "url": "https://github.com/ZwaarContrast/ol-graticule/issues"
  },
  "keywords": [
    "openlayers",
    "ol",
    "graticule",
    "grid",
    "heeresgitter",
    "heeresmeldenetz",
    "gauss-kruger",
    "bessel",
    "wehrmacht",
    "wwii",
    "military-grid"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --build --noEmit",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "ol": "^10.0.0",
    "@zwaarcontrast/ol-graticule": "^2.0.0",
    "@zwaarcontrast/ol-graticule-projected": "^2.0.0"
  },
  "dependencies": {
    "proj4": "^2.12.0"
  },
  "devDependencies": {
    "@zwaarcontrast/ol-graticule": "*",
    "@zwaarcontrast/ol-graticule-projected": "*",
    "@types/proj4": "^2.5.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.17"
  }
}
